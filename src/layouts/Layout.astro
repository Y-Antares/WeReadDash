---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "WeReadDash - 微信读书数据仪表盘" } = Astro.props;
---

<!usr/bin/env html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 antialiased min-h-screen selection:bg-emerald-500 selection:text-zinc-950">
    <slot />
  </body>
</html>