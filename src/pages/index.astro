---
import Layout from '../layouts/Layout.astro';
import StatCards from '../components/StatCards.jsx';
import ReadingTrendChart from '../components/ReadingTrendChart.jsx';
import ReadingHeatmap from '../components/ReadingHeatmap.jsx';
import RecentBooks from '../components/RecentBooks.jsx';

// 重点：直接导入本地静态 JSON 数据，无需任何 HTTP 请求！
import data from '../data/weread.json';
---

<Layout title="WeReadDash - 微信读书数据仪表盘">
  <main class="min-h-screen bg-zinc-950 text-zinc-100 p-4 sm:p-8 max-w-7xl mx-auto space-y-6">
    <header class="flex justify-between items-center border-b border-zinc-800 pb-5">
      <div class="flex items-center space-x-3">
        <img src={data.user.avatar} class="w-10 h-10 rounded-full border border-zinc-700" alt="Avatar" />
        <div>
          <h1 class="text-xl font-bold">{data.user.name} 的微信读书展板</h1>
          <p class="text-xs text-zinc-500">数据更新于 GitHub Actions</p>
        </div>
      </div>
    </header>

    <StatCards client:load user={data.user} />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <ReadingTrendChart client:load data={data.weeklyTrend} />
      <ReadingHeatmap client:load heatmapData={data.heatmap} />
    </div>

    <RecentBooks client:load books={data.books} />
  </main>
</Layout>