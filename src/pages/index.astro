---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/Dashboard.jsx';
import data from '../data/weread.json';
---

<Layout title="WeReadDash - 阅读数据看板">
  <main class="min-h-screen bg-zinc-950 text-zinc-100 p-4 sm:p-8 max-w-7xl mx-auto">
    <Dashboard client:load myData={data} />
  </main>
</Layout>